# Agentic Hybrid CRM — copy to .env and fill in secrets. Never commit .env.
# Production: inject these values from a secret manager and use TLS-enabled service URLs.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/agentic_crm
HOST=127.0.0.1
PORT=4100
API_KEY=
# Must exactly match ASP_SHARED_SECRET in the ASP deployment.
ASP_SHARED_SECRET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
EMAIL_API_KEY=
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_FROM=
APP_URL=http://localhost:4100
SESSION_TTL_HOURS=24
BOOTSTRAP_ADMIN_PASSWORD=
# Leave bootstrap password empty after first-user provisioning; never reuse a demo password.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=CRM_ANALYTICS
SNOWFLAKE_ROLE=
AGENT_ACTIONS_REQUIRE_APPROVAL=true
AGENT_MAX_ACTIONS_PER_RUN=10
OUTBOX_POLL_INTERVAL_MS=5000
