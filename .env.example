# Agentic Hybrid CRM — copy to .env and fill in secrets. Never commit .env.
# Production: inject these values from a secret manager and use TLS-enabled service URLs.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/agentic_crm
HOST=127.0.0.1
PORT=4100
API_KEY=
# Must exactly match ASP_SHARED_SECRET in the ASP deployment.
ASP_SHARED_SECRET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# groq uses the API key above. local permits loopback-only OpenAI-compatible servers such as Ollama.
LLM_PROVIDER=groq
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local-only
LLM_MODEL=llama3.2
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
EMAIL_API_KEY=
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_FROM=
APP_URL=http://localhost:4100
SESSION_TTL_HOURS=24
BOOTSTRAP_ADMIN_PASSWORD=
# Leave bootstrap password empty after first-user provisioning; never reuse a demo password.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=CRM_ANALYTICS
SNOWFLAKE_ROLE=
AGENT_ACTIONS_REQUIRE_APPROVAL=true
AGENT_MAX_ACTIONS_PER_RUN=10
OUTBOX_POLL_INTERVAL_MS=5000
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional bearer token for /metrics. Set in production and configure Prometheus auth.
METRICS_TOKEN=
