{
  "name": "agentic-hybrid-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "db:check": "node --env-file=.env --import tsx scripts/check-db.ts",
    "worker": "node --env-file=.env --import tsx src/worker.ts",
    "start:worker": "node dist/src/worker.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.5.0",
    "postgres": "^3.4.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
